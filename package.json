{
  "name": "latin-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "next dev --hostname 127.0.0.1",
    "dev:staging": "env-cmd -f .env.staging next dev",
    "dev:prod": "env-cmd -f .env.production next dev",
    "build": "next build",
    "build:dev": "env-cmd -f .env.development next build",
    "build:staging": "env-cmd -f .env.staging next build",
    "build:prod": "env-cmd -f .env.production next build",
    "build:all": "npm run build:dev && npm run build:staging && npm run build:prod",
    "start": "env-cmd -f .env.development next start",
    "start:staging": "env-cmd -f .env.staging next start",
    "start:prod": "env-cmd -f .env.production next start",
    "serve": "npm run build && npm run start",
    "serve:staging": "npm run build:staging && npm run start:staging",
    "serve:prod": "npm run build:prod && npm run start:prod",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest --config jest.config.mjs",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project demo-latin-app \"node tests/firestoreVocabularyRules.emulator.mjs\"",
    "test:watch": "jest --config jest.config.mjs --watch",
    "test:e2e": "node tests/e2e/preflight.mjs && playwright test --config=playwright.config.ts",
    "test:e2e:assessment": "node tests/e2e/preflight.mjs && playwright test tests/e2e/assessment-acceptance.spec.ts --config=playwright.config.ts",
    "test:e2e:assessment:repeat-score": "node tests/e2e/preflight.mjs && playwright test tests/e2e/assessment-acceptance.spec.ts --config=playwright.config.ts --workers=1 --repeat-each=2 --grep \"score-only normal submission\"",
    "test:e2e:ui": "playwright test --ui --config=playwright.config.ts",
    "test:e2e:debug": "playwright test --debug --config=playwright.config.ts",
    "test:e2e:report": "playwright show-report",
    "functions": "npm run functions:dev",
    "functions:dev": "firebase use dev && firebase deploy --only functions",
    "functions:staging": "firebase use staging && firebase deploy --only functions",
    "functions:prod": "firebase use prod && firebase deploy --only functions",
    "functions:all": "npm run functions:dev && npm run functions:staging && npm run functions:prod",
    "functions:serve": "firebase emulators:start --only functions",
    "firebase:emulators:e2e": "node tests/e2e/start-emulators.mjs",
    "sync:prod-content": "node scripts/sync-prod-content-to-dev.mjs",
    "sync:prod-content:dry-run": "node scripts/sync-prod-content-to-dev.mjs",
    "sync:prod-content:verify": "node scripts/sync-prod-content-to-dev.mjs --verify",
    "sync:prod-content:rollback": "node scripts/sync-prod-content-to-dev.mjs --rollback"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/storage": "7.16.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.5",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.5",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-hover-card": "^1.1.5",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.5",
    "@radix-ui/react-navigation-menu": "^1.2.4",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.7",
    "@reduxjs/toolkit": "^2.2.1",
    "@sentry/nextjs": "^10.71.0",
    "@stripe/stripe-js": "^5.5.0",
    "@tiptap/react": "^2.25.0",
    "@tiptap/starter-kit": "^2.25.0",
    "autoprefixer": "^10.4.17",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.4",
    "embla-carousel-react": "^8.5.2",
    "firebase": "^10.8.0",
    "firebase-admin": "^13.4.0",
    "framer-motion": "^12.15.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "object-hash": "^3.0.0",
    "openai": "^7.3.0",
    "playwright": "^1.53.1",
    "postcss": "^8.4.35",
    "react": "^19.2.7",
    "react-day-picker": "^9.5.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.54.2",
    "react-redux": "^9.1.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.0",
    "sharp": "^0.35.0",
    "sonner": "^1.4.0",
    "stripe": "^17.5.0",
    "swiper": "^12.0.2",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.19.0",
    "@firebase/rules-unit-testing": "3.0.4",
    "@playwright/test": "^1.53.1",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "env-cmd": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.37.4",
    "firebase-tools": "^15.25.1",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.21.0",
    "whatwg-fetch": "^3.6.20"
  },
  "overrides": {
    "undici": "5.28.4"
  },
  "jest": {
    "testEnvironment": "jest-environment-jsdom"
  }
}
