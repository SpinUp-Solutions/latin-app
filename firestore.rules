rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Audit records are written and read exclusively through authenticated API
    // routes. Keep student answers and expected answers out of direct client access.
    match /practiceCategories/{document=**} {
      allow read, write: if false;
    }

    match /practiceCategoryMemberships/{document=**} {
      allow read, write: if false;
    }

    // Lesson mutations run through server routes so category reconciliation,
    // membership cleanup, and publishing invariants cannot be bypassed.
    match /lessons/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /learningPaths/{document=**} {
      allow read, write: if false;
    }

    // The migration runtime is retired, but its immutable production audit
    // records remain server-only for operational history and incident review.
    match /learningPathMigrations/{document=**} {
      allow read, write: if false;
    }

    // Assessment content, attempts, and gate-controlling progress are available
    // only through authenticated server routes. The Admin SDK bypasses rules.
    match /testVersions/{document=**} {
      allow read, write: if false;
    }

    match /testVersionDrafts/{document=**} {
      allow read, write: if false;
    }

    match /testAttempts/{document=**} {
      allow read, write: if false;
    }

    match /testAttemptSessions/{document=**} {
      allow read, write: if false;
    }

    match /testResultReviews/{document=**} {
      allow read, write: if false;
    }

    match /studentMockResults/{document=**} {
      allow read, write: if false;
    }

    match /studentMockResultMigrations/{document=**} {
      allow read, write: if false;
    }

    match /mockTests/{document=**} {
      allow read, write: if false;
    }

    match /mockTestOrdering/{document=**} {
      allow read, write: if false;
    }

    match /userProgress/{document=**} {
      allow read, write: if false;
    }

    match /userProgressMigrationV2Backups/{document=**} {
      allow read, write: if false;
    }

    // AI evaluation inputs, generated outputs, and cache records are admin-only
    // server data accessed through authenticated Firebase Functions.
    match /aiEvaluationCases/{document=**} {
      allow read, write: if false;
    }

    match /aiEvaluationResultCache/{document=**} {
      allow read, write: if false;
    }

    match /aiEvaluationRunThrottles/{document=**} {
      allow read, write: if false;
    }

    // Vocabulary authoring and deletion archives are exposed only through
    // authenticated server routes. Direct SDK access would bypass admin checks,
    // confirmation challenges, and immutable archive guarantees.
    match /vocabulary_pools/{document=**} {
      allow read, write: if false;
    }

    match /vocabulary_words_v5/{document=**} {
      allow read, write: if false;
    }

    match /vocabulary_words_v4/{document=**} {
      allow read, write: if false;
    }

    match /vocabulary_word_requests/{document=**} {
      allow read, write: if false;
    }

    match /deleted_vocabulary_pools/{document=**} {
      allow read, write: if false;
    }

    match /vocabulary_pool_archives/{document=**} {
      allow read, write: if false;
    }

    match /vocabulary_pool_deletion_challenges/{document=**} {
      allow read, write: if false;
    }

    match /vocabulary_word_deletion_challenges/{document=**} {
      allow read, write: if false;
    }

    match /content_sync_locks/{document=**} {
      allow read, write: if false;
    }

    match /vocabulary_content_state/{document=**} {
      allow read, write: if false;
    }

    // User profiles remain readable for username availability checks, but the
    // role consumed by server-side admin authorization must not be writable by
    // clients. Administrative role changes use the Admin SDK, which bypasses
    // these rules.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'student';
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{collection}/{document=**} {
      allow read, write: if collection != 'diagramming_attempts'
        && !collection.matches('vocabulary_words_v[0-9]+')
        && collection != 'lessons'
        && collection != 'learningPaths'
        && collection != 'learningPathMigrations'
        && collection != 'practiceCategories'
        && collection != 'practiceCategoryMemberships'
        && collection != 'testVersions'
        && collection != 'testVersionDrafts'
        && collection != 'testAttempts'
        && collection != 'testAttemptSessions'
        && collection != 'testResultReviews'
        && collection != 'studentMockResults'
        && collection != 'studentMockResultMigrations'
        && collection != 'mockTests'
        && collection != 'mockTestOrdering'
        && collection != 'userProgress'
        && collection != 'userProgressMigrationV2Backups'
        && collection != 'aiEvaluationCases'
        && collection != 'aiEvaluationResultCache'
        && collection != 'aiEvaluationRunThrottles'
        && collection != 'vocabulary_pools'
        && collection != 'vocabulary_words_v5'
        && collection != 'vocabulary_words_v4'
        && collection != 'vocabulary_word_requests'
        && collection != 'deleted_vocabulary_pools'
        && collection != 'vocabulary_pool_archives'
        && collection != 'vocabulary_pool_deletion_challenges'
        && collection != 'vocabulary_word_deletion_challenges'
        && collection != 'content_sync_locks'
        && collection != 'vocabulary_content_state'
        && collection != 'users';
    }
  }
}
